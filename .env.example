# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/bot-pengeluaran

# Atau MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bot-pengeluaran?retryWrites=true&w=majority

# Server Port
PORT=3000

# JWT Secret (untuk authentication)
JWT_SECRET=your-secret-key-here-change-this-in-production

# Website URL (untuk link registrasi di pesan WhatsApp)
WEBSITE_URL=http://localhost:3000

# Admin Configuration
ADMIN_PASSWORD=admin123
